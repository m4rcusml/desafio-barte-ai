# =====================================================================
# CONFIGURAÇÕES E CHAVES DE API - TARVO CLOSING AGENT (EXEMPLO)
# Copie para src/.env ou .env na raiz; src/utils.py carrega o primeiro encontrado.
# Variáveis já definidas no ambiente do processo têm precedência.
# Sem chaves, o núcleo usa a heurística local. Não versione credenciais reais.
# =====================================================================

# 1. Jev (TypeSafe AI)
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# 2. Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 3. DeepSeek V1 Flash
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash

# 4. Governança
STATUS_FECHAMENTO=PROVISORIO
COMPETENCIA_FECHAMENTO=2026-09
