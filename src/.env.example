# =====================================================================
# CONFIGURAÇÕES E CHAVES DE API - TARVO CLOSING AGENT (EXEMPLO)
# Referência: configure estas variáveis no ambiente do processo.
# A aplicação não carrega arquivos .env automaticamente.
# Sem chaves, o núcleo usa a heurística local. Não versione credenciais reais.
# =====================================================================

# 1. Jev (TypeSafe AI)
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/decide
JEV_MODEL=jev-1

# 2. Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3. DeepSeek V1 Flash
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v1-flash

# 4. Governança
STATUS_FECHAMENTO=PROVISORIO
COMPETENCIA_FECHAMENTO=2026-09
